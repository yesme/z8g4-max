#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

export BB_DATA_DIR=${BB_DATA_DIR:-/srv/buildbarn/tiered}
if [[ $(findmnt -rn -o TARGET,FSTYPE -T "$BB_DATA_DIR") != '/ xfs' ]]; then
    echo 'Create the Buildbarn directories on the P4618 XFS before starting.' >&2
    exit 1
fi
/usr/local/sbin/z8-cold check
mapfile -t shards < <(jq -r '.active[]' /run/z8-cold/cold-layout.json)
(( ${#shards[@]} > 0 ))
stores=("$BB_DATA_DIR"/{cs-hot,cms,ac})
for shard in "${shards[@]}"; do stores+=("$BB_DATA_DIR/cold/$shard"); done
for store in "${stores[@]}"; do
    [[ -d "$store/persistent_state" && -w "$store/persistent_state" && -w "$store" ]] || {
        echo "Missing or unwritable directory $store/persistent_state" >&2
        exit 1
    }
done
# Existing cache files must be retired as a unit before changing their geometry.
for entry in 'blocks:1758789107712' 'key_location_map:27917287424'; do
    path="$BB_DATA_DIR/cs-hot/${entry%:*}"
    if [[ -e "$path" && $(stat -c %s -- "$path") != "${entry#*:}" ]]; then
        echo "Unexpected hot CS geometry in $path; retire the old hot CS as documented." >&2
        exit 1
    fi
done
