#!/usr/bin/env bash
set -euo pipefail
target=/data/buildbarn
source=$(findmnt -n -o SOURCE -M "$target") || {
    echo "Expected z8data/data/buildbarn mounted at $target" >&2
    exit 1
}
[[ $(findmnt -n -o FSTYPE -M "$target") == zfs && "$source" == z8data/data/buildbarn ]] || {
    echo "Unexpected dataset at $target: $source" >&2
    exit 1
}
[[ -w "$target" ]] || { echo "Cold storage is not writable: $target" >&2; exit 1; }
export BB_DATA_DIR=${BB_DATA_DIR:-/srv/buildbarn/tiered}
if [[ $(findmnt -n -o FSTYPE -T "$BB_DATA_DIR") != xfs ]]; then
    echo "Create the Buildbarn directories on the P4618 XFS before starting." >&2
    exit 1
fi
for store in cs cs-hot cms ac; do
    [[ -d "$BB_DATA_DIR/$store/persistent_state" && -w "$BB_DATA_DIR/$store/persistent_state" && -w "$BB_DATA_DIR/$store" ]] || {
        echo "Missing or unwritable directory $BB_DATA_DIR/$store/persistent_state" >&2
        exit 1
    }
done

# Set geometry once in the empty pool. Preserve it even when the pool fills.
# The service runs from /opt/z8-kit/buildbarn.
layout=cold-layout.json
tib_bytes=$((1024**4))
if [[ -e "$target/i4-cas-aging.bin" ]]; then
    echo "Finish I4 and remove $target/i4-cas-aging.bin before starting Buildbarn." >&2
    exit 1
fi
if [[ ! -e "$layout" ]]; then
    if [[ -e "$target/blocks" || -e "$BB_DATA_DIR/cs/key_location_map" ]]; then
        echo "Existing cold CAS needs its original $layout; recover its geometry before starting." >&2
        exit 1
    fi
    available=$(zfs list -Hp -o available "$source")
    [[ "$available" =~ ^[0-9]{1,16}$ ]] || {
        echo "Unexpected ZFS available byte count for $source: $available" >&2
        exit 1
    }
    tib=$(( available * 72 / 100 / tib_bytes ))
    (( tib > 0 && tib * tib_bytes * 100 >= available * 70 )) || {
        echo "Initial cold capacity rounding would fall below 70% of available space." >&2
        exit 1
    }
    temporary=$(mktemp "$layout.XXXXXX")
    trap 'rm -f -- "$temporary"' EXIT
    # Size for about 5 KiB per indexed chunk at 50% load.
    printf '{"tib":%s,"indexGib":%s}\n' "$tib" "$((tib * 26))" > "$temporary"
    ln -- "$temporary" "$layout"
fi
tib=$(jq -er '.tib | select(type == "number" and . == floor and . > 0 and . < 64)' "$layout") || {
    echo "Invalid cold CAS geometry in $layout; recover its recorded TiB capacity." >&2
    exit 1
}
index_gib=$(jq -er '(if has("indexGib") then .indexGib else .tib end) | select(type == "number" and . == floor and . > 0 and . <= 5960)' "$layout") || {
    echo "Invalid cold CAS index size in $layout; recover its recorded GiB capacity." >&2
    exit 1
}
if [[ -e "$target/blocks" ]] && [[ $(stat -c %s -- "$target/blocks") != "$((tib * tib_bytes))" ]]; then
    echo "Cold block file size differs from $layout; restore the original geometry." >&2
    exit 1
fi
if [[ -e "$BB_DATA_DIR/cs/key_location_map" ]] &&
    [[ $(stat -c %s -- "$BB_DATA_DIR/cs/key_location_map") != "$((index_gib * 1024**3))" ]]; then
    echo "Cold index size differs from $layout; restore the original geometry." >&2
    exit 1
fi
