#!/usr/bin/env python3
"""Scan only the verified cold CAS slices and overwrite persistent logical EIOs."""

import argparse
from concurrent.futures import ThreadPoolExecutor
import errno
import mmap
import os
from pathlib import Path
import subprocess
import sys

SECTOR = 4096
READ_SIZE = 4 * 1024**2
MEDIA_ERRORS = {errno.EIO, errno.ENODATA}
DEVICE_SIZE = 6510 * 256 * 1024**2
REQUESTS = Path(os.environ.get("Z8_COLD_HEALTH_STATE", "/var/lib/z8-cold-health"))
DISKS = tuple(f"sata{i}" for i in range(4))


def read_exact(fd, buffer, length, offset):
    with buffer[:length] as aligned:
        size = os.preadv(fd, [aligned], offset)
    if size != length:
        raise OSError(f"Short read at byte {offset}: {size}/{length}")


def scan(fd, size, emit=print):
    repaired = 0
    with mmap.mmap(-1, READ_SIZE) as read_buffer, mmap.mmap(-1, SECTOR) as zeros:
        with memoryview(read_buffer) as buf:
            for offset in range(0, size, READ_SIZE):
                length = min(READ_SIZE, size - offset)
                try:
                    read_exact(fd, buf, length, offset)
                    continue
                except OSError as exc:
                    if exc.errno not in MEDIA_ERRORS:
                        raise
                for sector in range(offset, offset + length, SECTOR):
                    try:
                        read_exact(fd, buf, SECTOR, sector)
                        continue
                    except OSError as exc:
                        if exc.errno not in MEDIA_ERRORS:
                            raise
                    try:
                        read_exact(fd, buf, SECTOR, sector)
                        continue
                    except OSError as exc:
                        if exc.errno not in MEDIA_ERRORS:
                            raise
                    if os.pwrite(fd, zeros, sector) != SECTOR:
                        raise OSError(f"Short zero write at byte {sector}")
                    os.fsync(fd)
                    read_exact(fd, buf, SECTOR, sector)
                    if buf[:SECTOR] != zeros[:]:
                        raise OSError(f"Nonzero data after repair at byte {sector}")
                    repaired += 1
                    emit(f"logical_offset={sector} bytes_zeroed={SECTOR}")
    return repaired


def scan_device(path, size):
    fd = os.open(path, os.O_RDWR | os.O_DIRECT)
    try:
        if os.lseek(fd, 0, os.SEEK_END) != size:
            raise ValueError(f"Wrong size for {path}")
        return scan(fd, size, lambda msg: print(f"{path}: {msg}", flush=True))
    finally:
        os.close(fd)


def scan_disk(shards):
    result = 0
    for shard in shards:
        path = Path(f"/dev/mapper/z8-cold-{shard}")
        try:
            count = scan_device(path, DEVICE_SIZE)
            print(f"{path}: bytes_scanned={DEVICE_SIZE} blocks_zeroed={count}", flush=True)
            result = max(result, int(count > 0))
        except (OSError, ValueError) as exc:
            print(f"{path}: scan stopped: {exc}", file=sys.stderr, flush=True)
            return 2
    return result


def request_stamp(disk):
    """Identify the scan request that z8-cold-health left open for this disk, if any."""
    try:
        return (REQUESTS / f"scan-owed-{disk}").stat().st_mtime_ns
    except FileNotFoundError:
        return None


def settle(disk, stamp):
    """Close the request this scan answered, unless new evidence arrived while it ran."""
    if stamp is not None and request_stamp(disk) == stamp:
        (REQUESTS / f"scan-owed-{disk}").unlink(missing_ok=True)


def main(disk=None):
    """Scan one cold disk, or all four, and return the exit status."""
    disks = (disk,) if disk else DISKS
    # z8-cold list verifies the complete tables, backing devices and sizes.
    shards = subprocess.check_output(["/usr/local/sbin/z8-cold", "list"], text=True).splitlines()
    groups = {name: [s for i in range(8) if (s := f"{name}-{i}") in shards] for name in disks}
    complete = {name: group for name, group in groups.items() if len(group) == 8}
    if len(complete) != len(disks):
        print(f"Scanning {len(complete)}/{len(disks)} ready cold disks.", file=sys.stderr, flush=True)
    stamps = {name: request_stamp(name) for name in complete}
    with ThreadPoolExecutor(max_workers=len(disks)) as pool:
        outcomes = list(pool.map(scan_disk, complete.values()))
    for name, outcome in zip(complete, outcomes):
        if outcome < 2:
            settle(name, stamps[name])
    return max([0 if len(complete) == len(disks) else 2, *outcomes])


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("disk", choices=DISKS, nargs="?")
    try:
        sys.exit(main(parser.parse_args().disk))
    except (OSError, subprocess.CalledProcessError) as error:
        sys.exit(f"z8-cold-scan: {error}")
