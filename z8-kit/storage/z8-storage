#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

pool=z8data
config=${Z8_STORAGE_CONFIG:-/etc/z8-storage}
action=${1:-}
case "$action" in
    map|unmap|import|export|cold-ready) [[ $# == 1 ]] ;;
    check-map) [[ $# == 2 && "$2" =~ ^[0-6]$ ]] ;;
    format) [[ $# == 3 && "$2" =~ ^[0-6]$ && ( "$3" == --create || "$3" == --replace ) ]] ;;
    *) echo 'Usage: z8-storage map|unmap|import|export|cold-ready or check-map SLOT or format SLOT --create|--replace' >&2; exit 2 ;;
esac || exit 2

# shellcheck source=/dev/null
source "$config/storage.env"
: "${Z8_OPTANE:?Set the D4800X whole-disk by-id}"
: "${Z8_DEVICE_WAIT:=90}"
[[ "$Z8_OPTANE" =~ ^/dev/disk/by-id/nvme-[^/[:space:]]+$ && ! "$Z8_OPTANE" =~ -part[0-9]+$ ]] || exit 2
[[ "$Z8_DEVICE_WAIT" =~ ^[1-9][0-9]{0,2}$ ]] || exit 2
if [[ $action == import || $action == export ]]; then
    [[ "${Z8_POOL_GUID:-}" =~ ^[0-9]+$ ]] || { echo 'Set the numeric ZFS pool GUID' >&2; exit 2; }
fi

special=/dev/disk/by-partlabel/z8-special
index=/dev/disk/by-partlabel/z8-cold-index
zone_bytes=$((256 * 1024**2))
names=() disks=() caches=()
while IFS=$'\t' read -r name disk label extra || [[ -n ${name:-} ]]; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    i=${#names[@]}
    [[ $i -lt 7 && "$name" == "hc620-$i" && "$label" == "dmz-sata$i" && -z "$extra" ]] || exit 2
    [[ "$disk" =~ ^/dev/disk/by-id/ata-[^/[:space:]]+$ && ! "$disk" =~ -part[0-9]+$ ]] || exit 2
    names+=("$name")
    disks+=("$disk")
    caches+=("/dev/disk/by-partlabel/$label")
done < "$config/hybrid.tsv"
(( ${#names[@]} == 7 )) || { echo 'Expected seven ordered rows in hybrid.tsv' >&2; exit 2; }
[[ $(printf '%s\n' "${disks[@]}" | sort -u | wc -l) -eq 7 ]] || exit 2

optane_geometry() {
    [[ -b "$Z8_OPTANE" && $(blockdev --getsize64 "$Z8_OPTANE") == 1500301910016 ]] || return 1
    optane_name=$(lsblk -dnro KNAME -- "$Z8_OPTANE") || return 1
    local lba
    lba=$(blockdev --getss "$Z8_OPTANE") || return 1
    [[ "$lba" == 512 || "$lba" == 4096 ]] || return 1
    special_bytes=$((1500301910016 - 1184 * 1024**3 - 1048576 - 16384 - lba))
}

check_partition() {
    local path=$1 bytes=$2
    [[ -b "$path" && $(lsblk -dnro PKNAME -- "$path") == "$optane_name" &&
        $(blockdev --getsize64 "$path") == "$bytes" ]]
}

cache_geometry() {
    if (( $1 < 4 )); then cache_bytes=25769803776; seq=96
    else cache_bytes=85899345920; seq=320
    fi
}

check_distinct_disks() {
    local disk resolved
    local -A seen=()
    for disk in "${disks[@]}"; do
        [[ -b "$disk" ]] || continue
        resolved=$(readlink -f "$disk")
        if [[ -n "${seen[$resolved]:-}" ]]; then
            echo "More than one HDD ID resolves to $resolved" >&2
            return 1
        fi
        seen[$resolved]=1
    done
}

is_expected_mapping() {
    local i=$1 name=${names[$1]} backing expected table mapper bytes
    [[ -b "/dev/mapper/$name" && -b "${disks[i]}" ]] || return 1
    cache_geometry "$i"
    check_partition "${caches[i]}" "$cache_bytes" || return 1
    bytes=$(blockdev --getsize64 "/dev/mapper/$name") || return 1
    [[ "$bytes" =~ ^[1-9][0-9]{0,14}$ ]] || return 1
    (( bytes % zone_bytes == 0 && bytes / zone_bytes >= 52080 && bytes / zone_bytes <= 52156 )) || return 1
    table=$(dmsetup table "$name") || return 1
    [[ "$table" != *$'\n'* && "$table" =~ ^0[[:blank:]]+([0-9]+)[[:blank:]]+zoned([[:blank:]]|$) && ${BASH_REMATCH[1]} == "$((bytes / 512))" ]] || return 1
    mapper=$(basename "$(readlink -f "/dev/mapper/$name")")
    backing=$(find "/sys/class/block/$mapper/slaves" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort) || return 1
    expected=$(for device in "${disks[i]}" "${caches[i]}"; do
        basename "$(readlink -f "$device")"
    done | sort)
    [[ "$backing" == "$expected" ]]
}

remove_known_zoned() {
    local name=$1 table
    table=$(dmsetup table "$name") || return 1
    if [[ "$table" == *$'\n'* || ! "$table" =~ ^[0-9]+[[:blank:]]+[0-9]+[[:blank:]]+zoned([[:blank:]]|$) ]]; then
        echo "Refusing to remove a non-zoned or multi-target mapping: $name" >&2
        return 1
    fi
    dmsetup remove "$name"
}

require_optane() {
    optane_geometry || { echo "Missing or invalid 1.5 TB D4800X: $Z8_OPTANE" >&2; exit 1; }
    check_distinct_disks
}

case "$action" in
    map)
        modprobe dm-zoned
        deadline=$((SECONDS + Z8_DEVICE_WAIT))
        while (( SECONDS < deadline )); do
            detected=0
            for i in "${!disks[@]}"; do
                if [[ -b "${disks[i]}" && -b "${caches[i]}" ]]; then
                    detected=$((detected + 1))
                fi
            done
            if [[ -b "$Z8_OPTANE" && -b "$special" && -b "$index" ]] && (( detected == 7 )); then
                break
            fi
            sleep 1
        done
        require_optane
        for i in "${!names[@]}"; do
            if dmsetup info "${names[i]}" >/dev/null 2>&1; then
                is_expected_mapping "$i" || echo "Skipping stale or unexpected backing for ${names[i]}" >&2
                continue
            fi
            cache_geometry "$i"
            if [[ -b "${disks[i]}" && $(lsblk -dnro ZONED -- "${disks[i]}") == host-managed ]] &&
                check_partition "${caches[i]}" "$cache_bytes"; then
                dmzadm --start "$(readlink -f "${caches[i]}")" "$(readlink -f "${disks[i]}")" ||
                    echo "Failed: ${names[i]}" >&2
            else
                echo "Missing or invalid HDD/cache pair: ${names[i]} (${disks[i]}, ${caches[i]})" >&2
            fi
        done
        udevadm settle --timeout=10 || true
        for i in "${!names[@]}"; do
            if is_expected_mapping "$i"; then
                echo "Ready: ${names[i]}"
            else
                echo "Unavailable: ${names[i]}" >&2
            fi
        done
        ;;
    unmap)
        if [[ -d /sys/module/zfs ]] && zpool list -H -o name "$pool" >/dev/null 2>&1; then
            echo "Export $pool before removing dm-zoned mappings" >&2
            exit 1
        fi
        failed=0
        for name in "${names[@]}"; do
            if dmsetup info "$name" >/dev/null 2>&1; then
                remove_known_zoned "$name" || failed=1
            fi
        done
        exit "$failed"
        ;;
    cold-ready)
        require_optane
        check_partition "$index" 910533066752 || { echo 'Missing or invalid z8-cold-index on D4800X' >&2; exit 1; }
        for i in {0..3}; do
            if is_expected_mapping "$i"; then
                printf 'sata%s\n' "$i"
            fi
        done
        ;;
    check-map)
        require_optane
        is_expected_mapping "$2"
        ;;
    format)
        require_optane
        i=$2
        cache_geometry "$i"
        disk=${disks[i]}
        cache=${caches[i]}
        if [[ ! -b "$disk" || $(lsblk -dnro ZONED -- "$disk") != host-managed ||
            $(blockdev --getss "$disk") != 4096 ]] || ! check_partition "$cache" "$cache_bytes"; then
            echo "Invalid HDD/cache pair: $disk $cache" >&2
            exit 1
        fi
        ! dmsetup info "${names[i]}" >/dev/null 2>&1 || { echo "Remove ${names[i]} before formatting." >&2; exit 1; }
        args=(--format "$(readlink -f "$cache")" "$(readlink -f "$disk")" "--label=${names[i]}" "--seq=$seq")
        if [[ $3 == --replace ]]; then args+=(--force); fi
        lsblk -b -o NAME,MODEL,SERIAL,SIZE,ZONED,PARTLABEL "$disk" "$cache"
        read -r -p "To erase this pair, enter ${names[i]}: " confirmation
        [[ "$confirmation" == "${names[i]}" ]] || exit 1
        dmzadm "${args[@]}"
        dmzadm --check "$(readlink -f "$cache")" "$(readlink -f "$disk")"
        ;;
    import)
        require_optane
        check_partition "$special" "$special_bytes" || { echo 'Missing or invalid z8-special on D4800X' >&2; exit 1; }
        existing=$(zpool list -H -o guid "$pool" 2>/dev/null || true)
        if [[ -n "$existing" ]]; then
            [[ "$existing" == "$Z8_POOL_GUID" ]] || { echo "Wrong GUID for $pool" >&2; exit 1; }
            exit 0
        fi
        search=(-d "$special")
        count=0
        for i in {4..6}; do
            if is_expected_mapping "$i"; then
                search+=(-d "/dev/mapper/${names[i]}")
                count=$((count + 1))
            fi
        done
        (( count >= 2 )) || { echo 'RAIDZ1 requires at least two of hc620-4/5/6' >&2; exit 1; }
        exec zpool import -N -o cachefile=none "${search[@]}" "$Z8_POOL_GUID"
        ;;
    export)
        existing=$(zpool list -H -o guid "$pool" 2>/dev/null || true)
        if [[ -n "$existing" ]]; then
            [[ "$existing" == "$Z8_POOL_GUID" ]] || { echo "Wrong GUID for $pool" >&2; exit 1; }
            exec zpool export "$pool"
        fi
        ;;
esac
