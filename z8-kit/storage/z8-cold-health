#!/usr/bin/env python3
"""Start drive self-tests and scan a cold CAS disk only when it reports media trouble."""

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

CONFIG = Path(os.environ.get("Z8_STORAGE_CONFIG", "/etc/z8-storage"))
STATE = Path(os.environ.get("STATE_DIRECTORY", "/var/lib/z8-cold-health"))
DISKS = tuple(f"sata{i}" for i in range(4))
MEDIUM_ERROR = re.compile(r"critical medium error, dev (sd[a-z]+),")
READ_FAILURE = 7
IN_PROGRESS = 15


def cold_devices():
    """Return {sataN: whole-disk by-id path} from the first four hybrid.tsv rows."""
    devices = {}
    for line in (CONFIG / "hybrid.tsv").read_text().splitlines():
        fields = line.split("\t")
        if len(fields) == 3 and (match := re.fullmatch(r"hc620-([0-3])", fields[0])):
            devices[f"sata{match.group(1)}"] = fields[1]
    if tuple(devices) != DISKS:
        raise ValueError("hybrid.tsv must list hc620-0 to hc620-3 in order")
    return devices


def smart(device):
    result = subprocess.run(["smartctl", "--json=c", "-a", device], capture_output=True, text=True)
    # Bits 0 and 1 report a bad command line or a device that could not be opened.
    if result.returncode & 3:
        raise OSError(f"smartctl failed for {device}: {result.stderr.strip() or result.stdout.strip()}")
    return json.loads(result.stdout)


def failed_selftests(report):
    table = report.get("ata_smart_self_test_log", {}).get("standard", {}).get("table", [])
    return sorted([entry.get("lifetime_hours", 0), entry.get("lba", -1)] for entry in table
                  if entry.get("status", {}).get("value", 0) >> 4 == READ_FAILURE)


def pending_sectors(report):
    for attribute in report.get("ata_smart_attributes", {}).get("table", []):
        if attribute.get("id") == 197:
            return attribute.get("raw", {}).get("value", 0)
    return 0


def selftest_running(report):
    status = report.get("ata_smart_data", {}).get("self_test", {}).get("status", {})
    return status.get("value", 0) >> 4 == IN_PROGRESS


def reasons(report, previous, medium_error):
    """Return why this disk needs a logical scan, and its new remembered state."""
    failures = failed_selftests(report)
    pending = pending_sectors(report)
    found = []
    if medium_error:
        found.append("kernel medium error")
    if previous is not None and any(entry not in previous["selftests"] for entry in failures):
        found.append("self-test read failure")
    # A used disk's old self-test log is history, but sectors pending now are not.
    if pending > (previous["pending"] if previous else 0):
        found.append(f"{pending} pending sectors")
    return found, {"pending": pending, "selftests": failures}


def scan_request(disk):
    """Marker for a scan that evidence asked for; z8-cold-scan removes it after covering the disk."""
    return STATE / f"scan-owed-{disk}"


def publish(path, content):
    """A power loss must not leave a partial baseline, request or journal cursor."""
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as f:
        tmp = Path(f.name)
        try:
            f.write(content.encode())
            f.flush()
            os.fsync(f.fileno())
            tmp.replace(path)
            directory = os.open(path.parent, os.O_DIRECTORY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
        finally:
            tmp.unlink(missing_ok=True)


def remember(devices):
    """Record this boot's kernel names against ATA by-id, including the drive serial."""
    boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip().replace("-", "")
    path = STATE / f"devices-{boot}.json"
    names = json.loads(path.read_text()) if path.exists() else {}
    for device in devices.values():
        name = os.path.basename(os.path.realpath(device))
        if re.fullmatch(r"sd[a-z]+", name):
            # If a name was reused within this boot, it cannot identify either disk by itself.
            names[name] = device if names.get(name, device) == device else None
    publish(path, json.dumps(names, sort_keys=True))


def kernel_medium_errors(candidate):
    """Read all retained boots; journalctl advances only a private copy of the cursor."""
    cursor = STATE / "journal.cursor"
    if cursor.exists():
        shutil.copyfile(cursor, candidate)
    args = ["journalctl", "_TRANSPORT=kernel", "-q", "--no-pager", "-o", "json",
            "--output-fields=MESSAGE", f"--cursor-file={candidate}"]
    errors = set()
    with tempfile.TemporaryFile(mode="w+") as journal:
        subprocess.run(args, stdout=journal, check=True)
        journal.seek(0)
        for line in journal:
            entry = json.loads(line)
            message = entry.get("MESSAGE")
            if isinstance(message, str) and (match := MEDIUM_ERROR.search(message)):
                errors.add((entry["_BOOT_ID"], match[1]))
    bad_devices = set()
    for boot, name in sorted(errors):
        if not re.fullmatch(r"[0-9a-f]{32}", boot):
            raise ValueError(f"Invalid journal boot ID: {boot!r}")
        path = STATE / f"devices-{boot}.json"
        device = json.loads(path.read_text()).get(name) if path.exists() else None
        if device:
            bad_devices.add(device)
        else:
            print(f"Unattributed medium error: boot={boot} dev={name}; check this boot's journal.",
                  file=sys.stderr, flush=True)
    return bad_devices


def check(devices):
    remember(devices)
    with tempfile.TemporaryDirectory(dir=STATE) as tmp:
        candidate = Path(tmp) / "cursor"
        bad_devices = kernel_medium_errors(candidate)
        status = check_reports(devices, bad_devices)
        if candidate.exists():
            publish(STATE / "journal.cursor", candidate.read_text())
        return status


def check_reports(devices, bad_devices):
    state_path = STATE / "state.json"
    state = json.loads(state_path.read_text()) if state_path.exists() else {}
    status = 0
    for disk, device in devices.items():
        medium_error = device in bad_devices
        request = scan_request(disk)
        owner = ""
        try:
            with request.open() as marker:
                owner = marker.readline().strip()
        except FileNotFoundError:
            pass
        if owner.startswith("/dev/disk/by-id/") and owner != device:
            request.unlink(missing_ok=True)
        try:
            report = smart(device)
        except (OSError, ValueError) as error:
            print(f"{disk}: {error}", file=sys.stderr, flush=True)
            status = 1
            # Kernel evidence alone is enough to open a durable scan request.
            report, found = None, ["kernel medium error"] if medium_error else []
        else:
            previous = state.get(disk)
            if previous and previous.get("serial") != report.get("serial_number"):
                # A replaced disk starts over: the old baseline and open request belong to the old disk.
                previous = None
                # New markers carry their by-id even when SMART was unreadable.
                # A first readable report must not cancel a request for this disk.
                if owner != device:
                    request.unlink(missing_ok=True)
            found, state[disk] = reasons(report, previous, medium_error)
            state[disk]["serial"] = report.get("serial_number")
        if found:
            publish(request, device + "\n" + ", ".join(found) + "\n")
        if request.exists():
            # A scan that was stopped, rejected or never started is requested again every day.
            why = ", ".join(found) or "earlier request not finished"
            print(f"{disk}: requesting logical scan ({why})", flush=True)
            if subprocess.run(["systemctl", "start", "--no-block", f"z8-cold-scan@{disk}.service"]).returncode:
                status = 1
        elif report:
            print(f"{disk}: no new media evidence", flush=True)
    publish(state_path, json.dumps(state, indent=2) + "\n")
    return status


def selftest(devices):
    status = 0
    for disk, device in devices.items():
        try:
            if selftest_running(smart(device)):
                print(f"{disk}: self-test already running", flush=True)
                continue
            subprocess.run(["smartctl", "-q", "errorsonly", "-t", "long", device], check=True)
            print(f"{disk}: extended self-test started", flush=True)
        except (OSError, ValueError, subprocess.CalledProcessError) as error:
            print(f"{disk}: {error}", file=sys.stderr, flush=True)
            status = 1
    return status


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["check", "selftest", "remember"])
    args = parser.parse_args()
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        sys.exit({"check": check, "selftest": selftest, "remember": remember}[args.action](cold_devices()))
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(f"z8-cold-health: {error}")
