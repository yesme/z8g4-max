[Unit]
Description=Scan and repair logical read errors in Z8 cold CAS
Requisite=z8-cold.service
PartOf=z8-cold.service
After=z8-cold.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /run/lock/z8-cold-scan.lock /usr/local/sbin/z8-cold-scan
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=idle
