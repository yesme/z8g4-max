[Unit]
Description=Mount Z8 Buildbarn cold storage
DefaultDependencies=no
BindsTo=z8-zpool.service
After=z8-zpool.service
Conflicts=umount.target
Before=umount.target

[Mount]
What=z8data/buildbarn
Where=/data/buildbarn
Type=zfs
Options=rw
TimeoutSec=60

[Install]
WantedBy=z8-zpool.service multi-user.target
