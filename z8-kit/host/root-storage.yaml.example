# Import this as autoinstall.yaml in the Xubuntu Desktop installer.
autoinstall:
  version: 1
  timezone: Asia/Shanghai
  shutdown: poweroff
  refresh-installer:
    update: false
  source:
    id: xubuntu-desktop
  drivers:
    install: false
  apt:
    fallback: abort
  identity:
    hostname: jackywang-xubuntu-max
    username: jackywang
    password: REPLACE_WITH_CRYPT_PASSWORD_HASH
  early-commands:
    - while [ ! -e /run/z8-storage-confirmed ]; do sleep 1; done
  storage:
    swap:
      size: 0
    config:
      - id: fit
        type: disk
        match: {serial: "REPLACE_FIT_ID_SERIAL"}
        ptable: gpt
        wipe: superblock
        grub_device: false
      - id: p4618-a
        type: disk
        match: {serial: "REPLACE_P4618_A_ID_SERIAL"}
        ptable: gpt
        wipe: superblock
        grub_device: false
      - id: p4618-b
        type: disk
        match: {serial: "REPLACE_P4618_B_ID_SERIAL"}
        ptable: gpt
        wipe: superblock
        grub_device: false
      - id: fit-esp
        type: partition
        device: fit
        number: 1
        size: 1G
        flag: boot
        grub_device: true
      - id: fit-boot
        type: partition
        device: fit
        number: 2
        size: 8G
      - id: fit-tools
        type: partition
        device: fit
        number: 3
        size: 24G
      - id: fit-recovery
        type: partition
        device: fit
        number: 4
        size: 8G
      - id: raid-a
        type: partition
        device: p4618-a
        number: 1
        size: -1
        flag: raid
        wipe: superblock
      - id: raid-b
        type: partition
        device: p4618-b
        number: 1
        size: -1
        flag: raid
        wipe: superblock
      - id: root-raid
        type: raid
        name: z8root
        raidlevel: 0
        metadata: "1.2"
        devices: [raid-a, raid-b]
      - {id: esp-fs, type: format, volume: fit-esp, fstype: fat32}
      - {id: boot-fs, type: format, volume: fit-boot, fstype: ext4}
      - {id: tools-fs, type: format, volume: fit-tools, fstype: ext4, label: Z8TOOLS}
      - {id: recovery-fs, type: format, volume: fit-recovery, fstype: ext4, label: Z8RECOVERY}
      - id: root-fs
        type: format
        volume: root-raid
        fstype: xfs
        extra_options: ["-d", "su=512k,sw=2", "-m", "crc=1,reflink=1"]
      - {id: mount-root, type: mount, device: root-fs, path: /}
      - {id: mount-boot, type: mount, device: boot-fs, path: /boot}
      - {id: mount-esp, type: mount, device: esp-fs, path: /boot/efi}
