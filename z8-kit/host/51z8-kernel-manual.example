// Upgrade the kernel, NVIDIA and ZFS together in a maintenance window.
Unattended-Upgrade::Package-Blacklist {
    "^linux-(image-|headers-|modules-|generic|tools-|objects-|signatures-)";
    "^(nvidia-|libnvidia-|xserver-xorg-video-nvidia-|libxnvctrl)";
    "^(zfs|libzfs|libzpool|libnvpair|libuutil)";
};
