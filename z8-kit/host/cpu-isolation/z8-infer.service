[Unit]
Description=Local DeepSeek with dedicated physical CPU cores
BindsTo=z8-pmem-model.service
After=z8-pmem-model.service
ConditionFileIsExecutable=/home/jackywang/.config/z8-infer/launch.sh

[Service]
Type=exec
User=jackywang
Slice=z8infer.slice
EnvironmentFile=/etc/z8-infer-cpu.env
MemoryLow=90G
OOMScoreAdjust=-900
Nice=-5
WorkingDirectory=/home/jackywang
ExecCondition=/usr/bin/findmnt -rn -M /srv/pmem-model -t xfs -O dax=always
ExecStartPre=+/usr/local/libexec/z8-cpu-mode reserve
ExecStart=/home/jackywang/.config/z8-infer/launch.sh
ExecStopPost=+/usr/local/libexec/z8-cpu-mode restore
TimeoutStartSec=60
TimeoutStopSec=300
